# Reglas de .gitignore del proyecto Omnimorph (AGENTS.md §3)

# Credenciales y variables de entorno
.env
.env.*
!.env.example

# Videos y audios generados / descargados
*.mp4
*.avi
*.mov
*.mkv
data/videos/
data/audio/
data/clean/chat_audit.jsonl
dashboard/media/

# Pesos de modelos
*.pt
*.pth
*.onnx

# Parquets pesados y salidas crudas
data/raw/*.parquet
outputs/
runs/
backups/

# Entornos virtuales y cachés
.venv/
.sv023/
.hf_cache/
.ultralytics/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Marca local de qué partido trae data/raw (la escribe dataset_manager)
data/raw/origen.json
