# Plantilla de Variables de Entorno — Omnimorph (IBM Cloud)
# INSTRUCCIONES: Copia este archivo a `.env` localmente (`cp .env.example .env`)
# NUNCA subas el archivo `.env` real a GitHub ni lo pegues en el chat de IBM Bob IDE.

IBM_CLOUD_API_KEY="TU_API_KEY_AQUI_NO_COMPARTIR"
WATSONX_URL="https://us-south.ml.cloud.ibm.com"
WATSONX_PROJECT_ID="TU_PROJECT_ID_AQUI"
WATSONX_MODEL_ID="ibm/granite-3-8b-instruct"

# Opcional: IBM Watson Text to Speech (si está habilitado en la cuenta del Lab)
WATSON_TTS_API_KEY=""
WATSON_TTS_URL=""
USE_LOCAL_TTS="true"
