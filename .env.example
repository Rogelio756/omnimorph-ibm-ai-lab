# .env.example — Omnimorph IBM Cloud credentials template
# =========================================================
# 1. Copia este archivo como .env  (nunca subir .env a Git)
# 2. Rellena los valores reales abajo
# 3. .env está en .gitignore — seguro

# ---------------------------------------------------------------------------
# IBM watsonx.ai — Narrador ibm/granite-3-8b-instruct (OBLIGATORIO para modo online)
# ---------------------------------------------------------------------------
# Obtén tu API Key en: https://cloud.ibm.com/iam/apikeys
IBM_CLOUD_API_KEY=<pega-tu-api-key-aqui>

# URL de la instancia watsonx.ai (elige tu región):
#   Dallas (us-south) : https://us-south.ml.cloud.ibm.com
#   Frankfurt (eu-de) : https://eu-de.ml.cloud.ibm.com
#   Londres (eu-gb)   : https://eu-gb.ml.cloud.ibm.com
#   Tokio (jp-tok)    : https://jp-tok.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Project ID de tu proyecto en watsonx.ai
# Encuéntralo en: https://dataplatform.cloud.ibm.com → tu proyecto → Manage → General → Project ID
WATSONX_PROJECT_ID=<pega-tu-project-id-aqui>

# ---------------------------------------------------------------------------
# IBM Watson Text to Speech (OPCIONAL — solo si USE_IBM_TTS=true)
# ---------------------------------------------------------------------------
USE_IBM_TTS=false
IBM_TTS_URL=https://api.us-south.text-to-speech.watson.cloud.ibm.com

# ---------------------------------------------------------------------------
# IBM Cloud Code Engine (para deploy_code_engine.py)
# ---------------------------------------------------------------------------
GITHUB_REPO_URL=https://github.com/Rogelio756/omnimorph-ibm-ai-lab
GITHUB_BRANCH=master
# CE_REGION=eu-gb   # Region de Code Engine (eu-gb = Londres, us-east, us-south)
# GITHUB_TOKEN=     # Solo si el repo es privado

# ---------------------------------------------------------------------------
# Hugging Face (OPCIONAL — para descarga del dataset bajo demanda)
# ---------------------------------------------------------------------------
# HF_TOKEN=<tu-token-hf>   # Solo necesario si el dataset es privado
